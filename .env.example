# Admin panel — these Google accounts get admin rights (comma separated)
ADMIN_EMAILS=paxbyme@gmail.com

# Signs the HttpOnly session cookie. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Absolute site URL, used to build the Google callback and Telegram webhook.
# Required HTTPS origin for telegram:setup/check. Google derives it from the
# request host when unset.
# SITE_URL=https://neosport-nu.vercel.app

# Legacy password login. Leave unset once Google sign-in works — an unset value
# disables the password path entirely.
# ADMIN_PASSWORD=replace-with-a-long-random-password

# Telegram order notifications
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_MESSAGE_THREAD_ID=123

# Telegram sign-in. The secret authenticates the webhook Telegram calls; without
# it the endpoint refuses every request. 16–256 characters: A-Z, a-z, 0-9, _ or -.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Phone numbers that get admin rights when signing in through Telegram
# (comma separated). Any spelling works: +998901234567, 998901234567, 901234567.
ADMIN_PHONES=998901234567

# Production product database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Used for the Google sign-in handshake only; this key is not a secret.
SUPABASE_ANON_KEY=replace-with-anon-key
